# ================================================================
# WhatsApp Attendance Bot - Environment Configuration Template
# Duplicate this file as .env and fill in your actual values.
# DO NOT commit your actual .env file to version control.
# ================================================================

# Google Gemini API Key (Get a free key from https://aistudio.google.com/)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# MongoDB Connection String (Atlas URI or local mongodb://localhost:27017/attendance_db)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/attendance_db?retryWrites=true&w=majority"

# Target WhatsApp Group Title (e.g. "Attendance Zaynlo 9:30 - 5:30🤝🏻")
GROUP_NAME="Your Target WhatsApp Group Name"

# Optional: Exact Group ID (e.g. 120363431289307868@g.us, logged in terminal on startup)
TARGET_GROUP_ID=""

# Application Timezone (Defaults to Asia/Kolkata)
TIMEZONE="Asia/Kolkata"

# Optional: Pair via 8-character code instead of QR code (Phone number with country code, e.g. 919876543210)
# PAIR_WITH_PHONE_NUMBER=919876543210
